{
  "name": "sipges",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test && pnpm test:tooling",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "fmt:changed": "bash scripts/fmt-changed.sh",
    "boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm lint && pnpm boundaries && pnpm typecheck && pnpm test",
    "e2e": "pnpm --filter @sipges/web build && pnpm --filter @sipges/e2e run e2e",
    "verify": "bash scripts/verify.sh",
    "verify:fast": "bash scripts/verify-fast.sh",
    "odd:check": "node scripts/odd-check-ids.mjs",
    "odd:close": "node scripts/odd-close-task.mjs",
    "odd:status": "node scripts/odd-status.mjs",
    "parity": "node apps/parity/src/main.ts",
    "engram": "node scripts/agents/engram.mjs",
    "test:tooling": "node --test scripts/tooling.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
