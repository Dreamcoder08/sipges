{
  "name": "mascli",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test && pnpm test:tooling",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm lint && pnpm boundaries && pnpm typecheck && pnpm test",
    "e2e": "pnpm --filter @mascli/web build && pnpm --filter @mascli/e2e run e2e",
    "verify": "bash scripts/verify.sh",
    "odd:close": "node scripts/odd-close-task.mjs",
    "test:tooling": "node --test scripts/tooling.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  }
}
