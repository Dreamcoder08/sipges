# HTTPS for a local network. Caddy is its own small certificate authority: `./sipges ca` exports
# its root certificate, which each computer installs once (docs/deployment/local-install.md).
{
	local_certs
	skip_install_trust
	default_sni {$SIPGES_SITE_HOST}
	admin off
}

{$SIPGES_SITE_HOST} {
	encode {
		zstd
		gzip
		match {
			header Content-Type text/javascript*
			header Content-Type text/css*
			header Content-Type text/html*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}
	# One API, or two when SIPGES_API_REPLICAS=2 (ADR 0035): taken in turns, each checked every 5 s
	# and skipped while it fails. A request that cannot reach one tries the other.
	reverse_proxy {$SIPGES_API_UPSTREAMS} {
		lb_policy round_robin
		lb_try_duration 5s
		lb_retries 2
		# The API answers only to the site's name.
		health_uri /health/ready
		health_headers {
			Host {$SIPGES_SITE_HOST}
		}
		health_interval 5s
		health_timeout 2s
		health_status 2xx
		# Short, so an API that was restarting is not still counted down when the other one restarts.
		fail_duration 5s
	}
}
