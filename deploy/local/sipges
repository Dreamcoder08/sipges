#!/usr/bin/env bash
# Runs a local SIPGES installation. Run `./sipges help` for the commands, and read
# docs/deployment/local-install.md first. SIPGES_ENV_FILE and SIPGES_PROJECT select another
# installation on the same machine (the restore drill uses them).
set -Eeuo pipefail
cd "$(dirname "$(readlink -f "$0")")"

ENV_FILE=${SIPGES_ENV_FILE:-.env}
PROJECT=${SIPGES_PROJECT:-sipges}
REPO_ROOT=../..

say() { printf '%s\n' "$*"; }
die() { printf 'sipges: %s\n' "$*" >&2; exit 1; }
env_value() { sed -n "s/^$1=//p" "$ENV_FILE" | tail -n 1; }
# SIPGES_API_REPLICAS=2 in the .env runs a second API, api-2, behind Caddy (ADR 0035). Anything but
# 1 or 2 is refused before a backup, a build or a container.
api_replicas() {
  local count=
  [[ ! -f $ENV_FILE ]] || count=$(env_value SIPGES_API_REPLICAS)
  case ${count:-1} in
  1 | 2) printf '%s' "${count:-1}" ;;
  *) die "SIPGES_API_REPLICAS must be 1 or 2, not \"$count\". Fix it in $ENV_FILE" ;;
  esac
}
# SIPGES_COMPOSE_OVERRIDE in the .env names a compose file of this installation's own choices, laid
# over compose.yaml on every call so start and update keep them. It belongs to the .env, not to this
# folder, so a drill's installation never picks up the owner's. A path that is gone stops the call
# instead of running without it.
compose() {
  local files=(-f compose.yaml) override=
  [[ ! -f $ENV_FILE ]] || override=$(env_value SIPGES_COMPOSE_OVERRIDE)
  if [[ -n $override ]]; then
    [[ -f $override ]] ||
      die "SIPGES_COMPOSE_OVERRIDE names $override, which does not exist. Fix the path in $ENV_FILE, or remove that line"
    files+=(-f "$override")
  fi
  # With an off-site remote set (world-class-local T13), every call sees the offsite service, so
  # stop and status include it.
  [[ ! -f $ENV_FILE || -z $(env_value SIPGES_BACKUP_OFFSITE) ]] || files+=(--profile offsite)
  local replicas
  replicas=$(api_replicas) || exit 1
  if [[ $replicas == 2 ]]; then
    SIPGES_API_UPSTREAMS='api:8080 api-2:8080' \
      docker compose --env-file "$ENV_FILE" -p "$PROJECT" "${files[@]}" --profile replica "$@"
  else
    docker compose --env-file "$ENV_FILE" -p "$PROJECT" "${files[@]}" "$@"
  fi
}
# die inside $(…) ends only that subshell, after printing its message: every caller that captures
# compose, api_replicas or api_services adds `|| exit 1`, so the script stops too and says it once
# (except healthy's polling, which runs after preflight and must survive a passing Docker error).
# The API services this installation runs, for the commands that stop them.
api_services() {
  local replicas
  replicas=$(api_replicas) || exit 1
  [[ $replicas == 2 ]] && printf 'api api-2' || printf 'api'
}
random_hex() { head -c "$1" /dev/urandom | od -An -tx1 | tr -d ' \n'; }

need_env() { [[ -f $ENV_FILE ]] || die "no $ENV_FILE here: run ./sipges install first"; }
need_docker() {
  command -v docker >/dev/null || die 'Docker is not installed'
  docker compose version >/dev/null 2>&1 || die 'Docker Compose is not installed'
  docker info >/dev/null 2>&1 || die 'Docker is not running, or this user may not use it'
}

check_host() {
  [[ $1 =~ ^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$ ]] ||
    die "\"$1\" is not a valid host name or address (use lower case, no port)"
}

# A name given on the command line always wins: on a first run it goes into a new .env, later it
# replaces the one there. Caddy issues the certificate for a new name by itself.
use_host() {
  local host=$1
  [[ -z $host ]] || check_host "$host"
  if [[ ! -f $ENV_FILE ]]; then
    write_env "${host:-localhost}"
  elif [[ -n $host && $host != "$(env_value SIPGES_SITE_HOST)" ]]; then
    sed -i "s/^SIPGES_SITE_HOST=.*/SIPGES_SITE_HOST=$host/" "$ENV_FILE"
    say "The address is now $host."
  fi
}

write_env() {
  local host=$1
  (
    umask 077
    : >"$ENV_FILE.new"
    cat >"$ENV_FILE" <<ENV
# Written once by ./sipges install. Keep a copy somewhere safe, away from this machine:
# without SIPGES_DATA_KEY and SIPGES_BACKUP_PASSPHRASE no backup can be used.
SIPGES_SITE_HOST=$host
SIPGES_ADMIN_USERNAME=admin
SIPGES_ADMIN_PASSWORD=$(random_hex 16)
SIPGES_DATA_KEY=$(head -c 32 /dev/urandom | base64 | tr -d '\n')
SIPGES_BACKUP_PASSPHRASE=$(random_hex 32)
SIPGES_DB_ADMIN_PASSWORD=$(random_hex 32)
SIPGES_DB_PASSWORD=$(random_hex 32)
SIPGES_DB_BACKUP_PASSWORD=$(random_hex 32)
SIPGES_HOST_OWNER=$(id -u):$(id -g)
SIPGES_BACKUP_DIR=./backups
SIPGES_BACKUP_HOUR=2
SIPGES_BACKUP_KEEP=14
SIPGES_TIMEZONE=America/Lima
ENV
  )
}

build() {
  # The drill's way to test install without touching images a real install may share.
  [[ -z ${SIPGES_SKIP_BUILD:-} ]] || return 0
  docker build -f "$REPO_ROOT/apps/api-go/Dockerfile" -t sipges-api-go:local "$REPO_ROOT"
  # The commit the build comes from, so ./sipges status can say which one runs (world-class-local T6).
  local revision
  revision=$(git -C "$REPO_ROOT" rev-parse --short=12 HEAD 2>/dev/null) || revision=unknown
  docker build -f Dockerfile --label "org.opencontainers.image.revision=$revision" -t sipges-local:new "$REPO_ROOT"
  # `previous` is the way back, so only a build that really started may become it: a real change
  # moves it only off the image `ready` vouches for, and a failed update can be retried freely.
  local running new started
  running=$(docker image inspect -f '{{.Id}}' sipges-local:current 2>/dev/null || true)
  started=$(docker image inspect -f '{{.Id}}' sipges-local:ready 2>/dev/null || true)
  new=$(docker image inspect -f '{{.Id}}' sipges-local:new)
  # An install from before `ready` existed has no mark: the version answering now earns it.
  if [[ -z $started && -n $running && -z $(env_value SIPGES_IMAGE_TAG) ]] && answers; then
    started=$running
  fi
  if [[ -n $running && $running != "$new" && $running == "$started" ]]; then
    docker tag sipges-local:current sipges-local:previous
  fi
  docker tag sipges-local:new sipges-local:current
  # The import tools embed the migrations, so they must not fall behind once they exist.
  if [[ -f Dockerfile.import ]] && docker image inspect sipges-import:current >/dev/null 2>&1; then
    docker build -f Dockerfile.import -t sipges-import:current "$REPO_ROOT"
  fi
}

answers() {
  compose exec -T caddy wget -qO- --header "Host: $(env_value SIPGES_SITE_HOST)" \
    http://api:8080/health/ready 2>/dev/null | grep -q '"ready"'
}

# Caddy checks each API every 2 s (Caddyfile) and skips one whose check failed while it booted, so
# once the API answers, one more check cycle passes before people are sent to it.
CADDY_CHECK_WAIT=3

wait_ready() {
  say 'Waiting for SIPGES to answer...'
  for _ in $(seq 1 90); do
    if answers; then
      sleep "$CADDY_CHECK_WAIT"
      say 'SIPGES is ready.'
      return 0
    fi
    sleep 2
  done
  compose ps
  die 'SIPGES did not become ready. See ./sipges logs'
}

image_tag() {
  local tag
  tag=$(env_value SIPGES_IMAGE_TAG)
  printf '%s' "${tag:-current}"
}

# Marks the image that just answered as one worth going back to. A drill, or an install running
# an older tag, says nothing about `current`.
mark_ready() {
  [[ $PROJECT == sipges && -z ${SIPGES_SKIP_BUILD:-} ]] || return 0
  [[ -z $(env_value SIPGES_IMAGE_TAG) ]] || return 0
  docker tag sipges-local:current sipges-local:ready
}

# Waits up to $2 tries, 2 seconds apart, for Docker to call the service's container healthy.
healthy() {
  local id
  for _ in $(seq 1 "$2"); do
    # preflight already refused a bad override or replica count, so a failure here is Docker's and
    # passing: keep polling, and let the caller's message say which API serves what.
    id=$(compose ps -q "$1") || id=
    if [[ -n $id && $(docker inspect -f '{{.State.Health.Status}}' "$id" 2>/dev/null) == healthy ]]; then
      return 0
    fi
    sleep 2
  done
  return 1
}

wait_db() {
  compose up -d db
  healthy db 150 || die 'the database did not become ready in 5 minutes. See ./sipges logs db'
}

unfinished_restore() { printf '%s/.restore-unfinished' "$(env_value SIPGES_BACKUP_DIR)"; }

# Everything that would stop a start, checked before anything slow or anything that changes state.
preflight() {
  [[ $(env_value SIPGES_BACKUP_HOUR) =~ ^([01]?[0-9]|2[0-3])?$ ]] ||
    die 'SIPGES_BACKUP_HOUR must be a whole hour from 0 to 23'
  api_replicas >/dev/null || exit 1
  if [[ -f $(unfinished_restore) ]]; then
    die "the restore of $(cat "$(unfinished_restore)") did not finish, so SIPGES stays off. Run ./sipges restore $(cat "$(unfinished_restore)") again"
  fi
  compose config -q
}

# Device notifications need a VAPID key pair: the image makes one the first time, and it is kept,
# since a new pair would cut off every device already subscribed. Keys an operator set stay.
ensure_push_keys() {
  [[ -z $(env_value SIPGES_VAPID_PUBLIC_KEY) && -z $(env_value SIPGES_VAPID_PRIVATE_KEY) ]] || return 0
  local keys
  if ! keys=$(docker run --rm --pull never --network none --entrypoint /api "sipges-local:$(image_tag)" vapid-keys) ||
    ! grep -qE '^SIPGES_VAPID_PUBLIC_KEY=.+$' <<<"$keys" || ! grep -qE '^SIPGES_VAPID_PRIVATE_KEY=.+$' <<<"$keys"; then
    say 'Device notifications stay off: this version cannot make their keys.'
    return 0
  fi
  # A hand-edited .env may lack its final newline: the block must not glue onto that last line.
  [[ ! -s $ENV_FILE || -z $(tail -c 1 "$ENV_FILE") ]] || printf '\n' >>"$ENV_FILE"
  {
    printf '# Device notifications (push), made once by ./sipges. A new pair cuts off subscribed devices.\n'
    grep -E '^SIPGES_VAPID_(PUBLIC|PRIVATE)_KEY=' <<<"$keys"
    # A contact the operator set stays: the last line would win.
    [[ -n $(env_value SIPGES_VAPID_SUBJECT) ]] ||
      printf 'SIPGES_VAPID_SUBJECT=mailto:sipges@%s\n' "$(env_value SIPGES_SITE_HOST)"
  } >>"$ENV_FILE"
}

# Follows the machine Docker runs on (local-qa-findings T16): on Windows and macOS that is Docker's
# virtual machine, the real limit. The APIs share a quarter of its memory, 1 to 4 GiB each, with a
# database pool of one connection per CPU, at least 4 as pgx chooses, at most 40, so two APIs stay
# under PostgreSQL's 100 connections. PostgreSQL gets another quarter, 1 to 4 GiB, and its settings
# from it (world-class-local T1). SIPGES_SIZING=manual in the .env keeps the operator's own values of
# every SIPGES_API_* and SIPGES_DB_* setting written here; a Docker that cannot say its size leaves
# the compose defaults. A changed size restarts the database at the next start or update.
size_host() {
  [[ $(env_value SIPGES_SIZING) != manual ]] || return 0
  local cpus bytes gib memory pool replicas db db_mib
  read -r cpus bytes < <(docker info --format '{{.NCPU}} {{.MemTotal}}' 2>/dev/null) || true
  [[ ${cpus:-} =~ ^[1-9][0-9]*$ && ${bytes:-} =~ ^[1-9][0-9]*$ ]] || return 0
  replicas=$(api_replicas) || exit 1
  gib=$((bytes / 1024 / 1024 / 1024))
  # The APIs share a quarter of the machine, up to 4 GiB each and never under 1 GiB each.
  memory=$((gib / 4 / replicas))
  ((memory >= 2)) || memory=1
  ((memory <= 4)) || memory=4
  pool=$((cpus < 4 ? 4 : cpus))
  ((pool <= 40)) || pool=40
  # PostgreSQL gets its own quarter, 1 to 4 GiB, so the kernel never picks it to free memory
  # for an unbounded neighbour; its settings follow that limit (world-class-local T1).
  db=$((gib / 4))
  ((db >= 1)) || db=1
  ((db <= 4)) || db=4
  db_mib=$((db * 1024))
  sed -i '/^SIPGES_API_MEMORY=/d; /^SIPGES_API_GOMEMLIMIT=/d; /^SIPGES_DB_POOL_MAX=/d; /^SIPGES_DB_MEMORY=/d; /^SIPGES_DB_SHARED_BUFFERS=/d; /^SIPGES_DB_EFFECTIVE_CACHE_SIZE=/d; /^SIPGES_DB_WORK_MEM=/d; /^SIPGES_DB_MAINTENANCE_WORK_MEM=/d; /^# Sized by .\/sipges/d' "$ENV_FILE"
  [[ ! -s $ENV_FILE || -z $(tail -c 1 "$ENV_FILE") ]] || printf '\n' >>"$ENV_FILE"
  # Go does not read the container's limit: its own target (the image's 800MiB for 1 GiB) grows
  # with it, or the larger limit would sit unused while Go collected garbage as if it had 1 GiB.
  printf '# Sized by ./sipges for %s CPUs and %s GiB; SIPGES_SIZING=manual keeps your own values.\nSIPGES_API_MEMORY=%sg\nSIPGES_API_GOMEMLIMIT=%sMiB\nSIPGES_DB_POOL_MAX=%s\n' \
    "$cpus" "$gib" "$memory" "$((memory * 800))" "$pool" >>"$ENV_FILE"
  # work_mem is per sort or hash step, per connection, and a hash step takes twice it: what is left
  # of the limit after shared_buffers, three autovacuum workers' maintenance_work_mem and about 8 MB
  # per connection (30 MB for the background processes), shared by every connection of every API
  # plus migrate and backup, each running one hash step. 4 to 64 MB.
  local shared maintenance connections work
  shared=$((db_mib / 4))
  maintenance=$((db_mib / 16))
  connections=$((replicas * pool + 2))
  work=$(((db_mib - shared - 3 * maintenance - 8 * connections - 30) / (2 * connections)))
  ((work >= 4)) || work=4
  ((work <= 64)) || work=64
  printf 'SIPGES_DB_MEMORY=%sg\nSIPGES_DB_SHARED_BUFFERS=%sMB\nSIPGES_DB_EFFECTIVE_CACHE_SIZE=%sMB\nSIPGES_DB_WORK_MEM=%sMB\nSIPGES_DB_MAINTENANCE_WORK_MEM=%sMB\n' \
    "$db" "$shared" "$((db_mib / 2))" "$work" "$maintenance" >>"$ENV_FILE"
  say "Sized for $cpus CPUs and $gib GiB: each API may use ${memory} GiB, the database ${db} GiB, with $pool database connections."
}

start() {
  mkdir -p "$(env_value SIPGES_BACKUP_DIR)"
  check_copy_folder
  preflight
  size_host
  ensure_push_keys
  local replicas
  replicas=$(api_replicas) || exit 1
  if [[ $replicas == 2 ]]; then
    roll_apis
  else
    remove_second_api
    compose up -d db api caddy backup
  fi
  wait_ready
  mark_ready
  refresh_copy_mount
  [[ -z $(env_value SIPGES_BACKUP_OFFSITE) ]] || start_offsite
}

# A container keeps the mount it started with: a disk plugged in after it started, or plugged
# back in, shows only in a new one. With a copy folder set, start gives the backup service one.
refresh_copy_mount() {
  [[ -n $(env_value SIPGES_BACKUP_COPY_DIR) ]] || return 0
  compose up -d --no-deps --force-recreate backup
}

# Two APIs restart one at a time, so one always answers through Caddy. The migrations run while
# the old version still serves, which is why each one must keep the previous version working.
roll_apis() {
  compose run --rm migrate || die 'the database changes failed, so both APIs keep the version they had. See the lines above'
  compose up -d --no-deps api
  healthy api 90 ||
    die 'the new version of the first API did not become healthy; the second API still serves the version it had. See ./sipges logs api'
  # Caddy's active check runs every 2 s (health_interval) and a failed request keeps an API out for
  # 5 s (fail_duration): 10 s lets it count the first API back in before the second one goes down.
  sleep 10
  compose up -d --no-deps api-2
  healthy api-2 90 || die 'the second API did not become healthy; the first one serves alone. See ./sipges logs api-2'
  compose up -d --no-deps caddy backup
}

# Back to one API: a second one left from SIPGES_API_REPLICAS=2 would keep running the old version.
remove_second_api() {
  local -a stale
  mapfile -t stale < <(docker ps -aq --filter "label=com.docker.compose.project=$PROJECT" \
    --filter label=com.docker.compose.service=api-2)
  ((${#stale[@]} == 0)) || docker rm -f "${stale[@]}" >/dev/null
}

cmd_install() {
  need_docker
  use_host "${1:-}"
  preflight
  build
  start
  say "Open https://$(env_value SIPGES_SITE_HOST)/"
  # Until this prints, the first sign-in is still owed, even after a failed build and a retry.
  if [[ -f $ENV_FILE.new ]]; then
    say "First sign-in: user $(env_value SIPGES_ADMIN_USERNAME), password $(env_value SIPGES_ADMIN_PASSWORD)"
    say 'Set up the authenticator code when asked, then keep a copy of the .env file off this machine.'
    command rm -f "$ENV_FILE.new"
  fi
}

# First install for a client who brings data: everything but the API, because migrate-legacy needs
# a database the API has never touched. `./sipges start` finishes the install after the import.
cmd_prepare() {
  need_docker
  use_host "${1:-}"
  preflight
  local ran
  ran=$(compose ps -aq api) || exit 1
  [[ -z $ran ]] ||
    die 'the app has already run here, so a legacy import would refuse. To start over: ./sipges wipe, then ./sipges prepare'
  build
  mkdir -p "$(env_value SIPGES_BACKUP_DIR)"
  compose up -d db backup
  say 'Ready for ./sipges import. Start SIPGES afterwards with ./sipges start.'
}

import_image() {
  docker image inspect sipges-import:current >/dev/null 2>&1 ||
    docker build -f Dockerfile.import -t sipges-import:current "$REPO_ROOT"
}

# The import tools run as the API's user, with this user's group added. That reaches the client's
# copy and the reports without opening either to other accounts, as long as the group is this
# user's alone, which is the default on Debian, Ubuntu and Fedora.
check_private_group() {
  local gid uid sharing
  gid=$(id -g)
  uid=$(id -u)
  ((uid != 0)) || die 'run this as the user who installed SIPGES, not as root'
  sharing=$(getent group "$gid" | cut -d: -f4 | tr ',' '\n' | grep -vx "$(id -un)" || true)
  sharing+=$(getent passwd | awk -F: -v gid="$gid" -v uid="$uid" '$4 == gid && $3 != uid' || true)
  [[ -z $sharing ]] ||
    die "the group $(id -gn) is shared with other accounts, so they could read the client's files. Use an account of its own for SIPGES: see \"Bringing in the client's data\" in the guide"
}

# A path inside the repository is refused: the repository's data/ folder is not client input, and
# client files must never land here.
check_place() {
  local folder=$1 real repo
  real=$(readlink -f "$folder" || true)
  repo=$(readlink -f "$REPO_ROOT")
  [[ -n $real && -d $real ]] || die "no folder $folder"
  [[ $real != "$repo" && $real != "$repo"/* ]] || die 'use a folder outside the SIPGES folder'
  [[ $real != *:* ]] || die 'the folder path may not contain a colon'
}

# Everything that can be refused before a backup or a container. A file neither this group nor
# everyone may read would look missing to the tools.
check_source() {
  local folder=$1 file=${2:-} real blocked open gid
  check_place "$folder"
  real=$(readlink -f "$folder")
  gid=$(id -g)
  local -a no_dir=(! '(' -group "$gid" -perm -g=rx ')' ! -perm -o=rx)
  local -a no_file=(! '(' -group "$gid" -perm -g=r ')' ! -perm -o=r)
  if [[ -n $file ]]; then
    blocked=$(find "$real" -maxdepth 0 "${no_dir[@]}"; find "$real/$file" "${no_file[@]}")
    open=$(find "$real/$file" -perm -o=r)
  else
    blocked=$(find "$real" \( -type d "${no_dir[@]}" -o -type f "${no_file[@]}" \) -print -quit)
    open=$(find "$real" ! -type l -perm -o=r -print -quit)
  fi
  [[ -z $blocked ]] ||
    die "SIPGES cannot read $blocked. Copy the folder to this computer, run chgrp -R $(id -gn) on the copy and then chmod -R u+rwX,g+rX,o-rwx on the copy, and import the copy."
  [[ -z $open ]] ||
    say "WARNING: other users of this computer can read $open. On a copy, close it with chmod -R o-rwx."
}

# Runs one import tool with the folder mounted read-only.
run_import() {
  local tool=$2 real reports
  real=$(readlink -f "$1")
  shift 2
  reports=$(import_reports)
  open_reports "$reports"
  wait_db
  SIPGES_IMPORT_FOLDER=$real SIPGES_IMPORT_REPORTS=$reports SIPGES_HOST_GID=$(id -g) \
    compose run --rm --entrypoint "$tool" import "$@"
}

import_reports() { readlink -m "${SIPGES_IMPORT_REPORTS:-imports}"; }

# The tool runs as the API's user, so its reports keep this folder's group, and this user reads
# them through it. Only this user's group may write here, and only until the command ends. The
# reports hold counts, codes and ids.
open_reports() {
  mkdir -p "$1"
  chgrp "$(id -g)" "$1"
  chmod 2770 "$1"
  # shellcheck disable=SC2064 # the path is fixed now, on purpose
  trap "chmod u=rwx,g=,o=,g-s $(printf '%q' "$1")" EXIT
}

backup_now() {
  wait_db
  compose up -d backup
  compose exec -T backup bash /ops/backup.sh
}

cmd_import() {
  need_env
  need_docker
  local kind=${1:-} target=${2:-}
  [[ -n $kind && -n $target ]] ||
    die 'usage: ./sipges import legacy <folder> [--apply|--verify] | import base-maestra <file.json> [--apply]'
  shift 2
  local apply=0 arg
  for arg in "$@"; do
    [[ $arg == --apply ]] && apply=1
  done
  case $kind in
  legacy)
    local report failed=0
    report="report-$(date -u +%Y%m%dT%H%M%SZ).json"
    check_private_group
    check_source "$target"
    import_image
    ((apply == 0)) || backup_now
    run_import "$target" migrate-legacy --legacy-root /import --report "/reports/$report" "$@" || failed=1
    # A tool that stops before it starts, on a refused option for one, writes no report.
    [[ -f "$(import_reports)/$report" ]] || die 'the import did not run; the line above says why'
    docker run --rm -i --network none --entrypoint /api sipges-local:current import-report \
      <"$(import_reports)/$report"
    say "Full report: $(import_reports)/$report"
    ((failed == 0)) || die 'the import reported problems; the report names them'
    ;;
  base-maestra)
    [[ -f $target ]] || die "no file $target"
    check_private_group
    check_source "$(dirname "$target")" "$(basename "$target")"
    import_image
    ((apply == 0)) || backup_now
    run_import "$(dirname "$target")" import-base-maestra --seed "/import/$(basename "$target")" "$@"
    ;;
  *) die 'import what? legacy or base-maestra' ;;
  esac
}

# Only reads: the folder is mounted read-only into a container with no network and no database
# setting. A file SIPGES cannot read is an answer here, not a refusal: it is a line of the report.
cmd_inventory() {
  need_env
  need_docker
  local folder=${1:-} arg
  local -a options=()
  [[ -n $folder ]] || die 'usage: ./sipges inventory <folder> [--show-unconfirmed-headers]'
  shift
  for arg in "$@"; do
    [[ $arg == --show-unconfirmed-headers ]] || die "unknown option $arg"
    options+=("$arg")
  done
  docker image inspect "sipges-local:$(image_tag)" >/dev/null 2>&1 || die 'no SIPGES build here yet: run ./sipges prepare first'
  check_private_group
  check_place "$folder"
  local real reports report
  real=$(readlink -f "$folder")
  reports=$(import_reports)
  report="inventory-$(date -u +%Y%m%dT%H%M%SZ)-$$.json"
  open_reports "$reports"
  SIPGES_IMPORT_FOLDER=$real SIPGES_IMPORT_REPORTS=$reports SIPGES_HOST_GID=$(id -g) \
    compose run --rm inventory inventory --root /import --report "/reports/$report" "${options[@]}"
  say "Full report: $reports/$report"
  say 'It names files, sheets and columns, so keep it as private as the files themselves.'
  ((${#options[@]} == 0)) ||
    say 'You asked for unconfirmed headers: those rows may be real data. Read this report yourself before sharing it.'
}

cmd_status() {
  need_env
  compose ps
  local dir latest
  dir=$(env_value SIPGES_BACKUP_DIR)
  if answers; then
    say 'Application: ready'
  else
    say 'Application: NOT READY'
  fi
  local build
  build=$(docker image inspect -f '{{index .Config.Labels "org.opencontainers.image.revision"}}' sipges-local:current 2>/dev/null) || true
  # An image built before the label existed answers <no value>.
  [[ -n $build && $build != '<no value>' ]] || build=unknown
  say "Build: $build"
  latest=$(find "$dir" -mindepth 1 -maxdepth 1 -type d -name '20*Z' -printf '%f\n' 2>/dev/null | sort | tail -n 1)
  say "Latest backup: ${latest:-none yet}"
  # 26 hours: a day plus the time a nightly backup may take (world-class-local T2).
  if [[ -n $latest && -z $(find "$dir/$latest" -maxdepth 0 -mmin -1560 2>/dev/null) ]]; then
    say 'WARNING: the newest backup is more than 26 hours old. Is the computer often off at the backup hour? See ./sipges logs backup'
  fi
  if [[ -f $dir/.last-failure ]]; then
    say "WARNING: the nightly backup failed at $(cat "$dir/.last-failure"). See ./sipges logs backup"
  fi
  if [[ -f $dir/.last-copy-failure ]]; then
    local when reason
    read -r when reason <"$dir/.last-copy-failure"
    say "WARNING: the copy to the second disk failed at $when: $reason"
  elif [[ -n $(env_value SIPGES_BACKUP_COPY_DIR) ]]; then
    say "Backups copied to: $(env_value SIPGES_BACKUP_COPY_DIR)"
  elif [[ -n $(env_value SIPGES_BACKUP_OFFSITE) ]]; then
    : # the off-site lines below say where the copy goes
  else
    # One dead disk loses the data and every backup beside it (world-class-local T3).
    say 'WARNING: the backups are only on this computer: a dead disk loses them with the data. Plug in a second disk and run ./sipges copy-backups-to <folder on it>'
  fi
  offsite_status "$dir"
  kit_confirmed ||
    say 'WARNING: no recovery kit confirmed: without SIPGES_DATA_KEY and SIPGES_BACKUP_PASSPHRASE no backup can be opened. Run ./sipges recovery-kit'
}

# The recovery kit (world-class-local T4): without SIPGES_DATA_KEY and SIPGES_BACKUP_PASSPHRASE no
# backup can be opened, by anyone, so the owner keeps them on paper away from this computer. What is
# recorded once confirmed is a fingerprint of both, never the secrets: a changed secret needs a new
# kit, and status says so until then.
recovery_mark() { printf '%s/.sipges-recovery-kit' "$(dirname "$ENV_FILE")"; }
secrets_fingerprint() {
  local hash
  hash=$(printf '%s\n%s' "$(env_value SIPGES_DATA_KEY)" "$(env_value SIPGES_BACKUP_PASSPHRASE)" |
    { sha256sum 2>/dev/null || shasum -a 256; })
  printf '%s' "${hash%% *}"
}
# An empty fingerprint (no sha256sum or shasum here) never counts as confirmed.
kit_confirmed() {
  local fingerprint
  fingerprint=$(secrets_fingerprint)
  [[ -n $fingerprint && -f $(recovery_mark) && $(cat "$(recovery_mark)") == "$fingerprint" ]]
}
cmd_recovery_kit() {
  need_env
  local file=${1:-sipges-recovery-kit.txt} pass key answer
  pass=$(env_value SIPGES_BACKUP_PASSPHRASE)
  key=$(env_value SIPGES_DATA_KEY)
  [[ -n $pass && -n $key ]] || die "SIPGES_BACKUP_PASSPHRASE and SIPGES_DATA_KEY must be in $ENV_FILE"
  # Its last 4 characters confirm the paper, so a shorter one would confirm with nothing typed.
  ((${#pass} >= 4)) || die "SIPGES_BACKUP_PASSPHRASE is shorter than 4 characters: install writes 64. Set a long one in $ENV_FILE first"
  [[ -n $(secrets_fingerprint) ]] || die 'this computer has neither sha256sum nor shasum, so the kit cannot be confirmed'
  (
    umask 077
    cat >"$file" <<KIT
SIPGES recovery kit - $(date -u +%Y-%m-%d)
Keep this sheet on paper, away from this computer. Anyone holding it and a backup can read the data.

Site:            $(env_value SIPGES_SITE_HOST)
Backups folder:  $(env_value SIPGES_BACKUP_DIR)
Copy folder:     $(env_value SIPGES_BACKUP_COPY_DIR)
Off-site copy:   $(env_value SIPGES_BACKUP_OFFSITE)

SIPGES_DATA_KEY=$key
SIPGES_BACKUP_PASSPHRASE=$pass

To restore on another computer:
1. Install SIPGES there: ./sipges install
2. In its .env, replace SIPGES_DATA_KEY and SIPGES_BACKUP_PASSPHRASE with the two lines above.
3. Copy a backup folder (such as 20261121T070000Z) into its backups folder. With an off-site copy,
   put a copy of the rclone folder next to ./sipges instead (keep it with the .env, not on paper),
   then run ./sipges offsite-to with the remote above and ./sipges backups --offsite.
4. Run ./sipges restore <that folder name>
KIT
    chmod 600 "$file"
  )
  say "Wrote $file. Print it, keep the paper somewhere safe, then delete the file."
  say 'Type the last 4 characters of SIPGES_BACKUP_PASSPHRASE from the paper to confirm:'
  read -r answer || true
  [[ -n $answer && $answer == "${pass: -4}" ]] || die 'that does not match the end of the passphrase: nothing was recorded'
  (
    umask 077
    secrets_fingerprint >"$(recovery_mark)"
  )
  say 'Recovery kit confirmed.'
}

# A copy of every backup on a second disk (local-qa-findings T15): a dead disk loses the data and
# the backups beside it. The folder gets a mark, and the backup copies only into a marked folder:
# with the disk unplugged, Docker would mount an empty folder of this disk in its place.
COPY_MARK=.sipges-backup-copy
cmd_copy_backups_to() {
  need_env
  [[ -n ${1:-} ]] || die 'say where: ./sipges copy-backups-to /media/usb/sipges-backups'
  [[ -d $1 ]] || die "$1 is not a folder here. Plug in the disk and create the folder first"
  local dir backups
  dir=$(readlink -f "$1")
  backups=$(readlink -m "$(env_value SIPGES_BACKUP_DIR)")
  if [[ $dir == "$backups" || $dir == "$backups"/* ]]; then
    die "$dir is the backup folder itself: choose a folder on another disk"
  fi
  touch "$dir/$COPY_MARK" 2>/dev/null || die "cannot write in $dir"
  # A folder made while the disk was unplugged lands on this disk: then a dead disk loses both.
  if [[ -d $backups && $(stat -c %d "$dir") == "$(stat -c %d "$backups")" ]]; then
    say "WARNING: $dir is on the same disk as the backups, so a dead disk loses both. Is the other disk plugged in?"
  fi
  sed -i '/^SIPGES_BACKUP_COPY_DIR=/d' "$ENV_FILE"
  [[ ! -s $ENV_FILE || -z $(tail -c 1 "$ENV_FILE") ]] || printf '\n' >>"$ENV_FILE"
  printf 'SIPGES_BACKUP_COPY_DIR=%s\n' "$dir" >>"$ENV_FILE"
  say "Every backup will also be copied to $dir."
  say 'Run ./sipges start to apply it, then ./sipges backup to make the first copy now.'
}

# Says, without stopping anything, that the copy folder has lost its mark.
check_copy_folder() {
  local dir
  dir=$(env_value SIPGES_BACKUP_COPY_DIR)
  [[ -n $dir && ! -f $dir/$COPY_MARK ]] || return 0
  say "WARNING: $dir is not marked as the backup copy (is the disk plugged in?). Backups go on without a copy until it is back and ./sipges start runs again."
}

# An off-site copy of every backup (world-class-local T13): the offsite service pushes the sealed
# backups, already encrypted, to an rclone remote such as SFTP or S3-compatible storage. Its
# credentials live in rclone/rclone.conf (folder SIPGES_RCLONE_DIR), never in the .env: only a
# remote named there is accepted, so no password ends up in the .env, status or the recovery kit.
rclone_dir() { local d; d=$(env_value SIPGES_RCLONE_DIR); printf '%s' "${d:-./rclone}"; }

# Made before any run, private and owned by the installing user, whom the service runs as: Docker
# would otherwise create the folder as root.
ensure_rclone_conf() {
  local dir
  dir=$(rclone_dir)
  (umask 077 && mkdir -p "$dir" && touch "$dir/rclone.conf") || die "cannot create $dir/rclone.conf"
  { chmod 700 "$dir" && chmod 600 "$dir/rclone.conf"; } || die "cannot make $dir private" # either fails: die
}

start_offsite() {
  ensure_rclone_conf
  compose up -d offsite
}

cmd_offsite_config() {
  need_env
  ensure_rclone_conf
  say "Answer rclone's questions to add a remote; its settings go to $(rclone_dir)/rclone.conf. Then run ./sipges offsite-to <remote>:<folder>."
  say "For SFTP, save the server's key first (ssh-keyscan <host> >$(rclone_dir)/known_hosts) and answer known_hosts_file with /config/known_hosts."
  compose run --rm --no-deps --entrypoint rclone offsite config
}

cmd_offsite_to() {
  need_env
  local remote=${1:-}
  [[ -n $remote ]] || die 'say where: ./sipges offsite-to nas:sipges-backups (see ./sipges offsite-config), or --off'
  if [[ $remote == --off ]]; then
    [[ -z $(env_value SIPGES_BACKUP_OFFSITE) ]] || compose rm -sf offsite
    sed -i '/^SIPGES_BACKUP_OFFSITE=/d' "$ENV_FILE"
    say 'Backups are no longer pushed off-site. What is already on the remote stays there.'
    return
  fi
  [[ $remote != :* ]] ||
    die 'use a remote named in rclone.conf (./sipges offsite-config), not a connection string: it would put a password in the .env'
  [[ $remote =~ ^[A-Za-z0-9_][A-Za-z0-9_.\ -]*:.*$ ]] ||
    die "$remote is not an rclone remote such as nas:sipges-backups. For a folder on another disk, use ./sipges copy-backups-to"
  ensure_rclone_conf
  compose run --rm --no-deps -e SIPGES_BACKUP_OFFSITE="$remote" offsite probe ||
    die "could not write to $remote. Is it set up? See ./sipges offsite-config"
  sed -i '/^SIPGES_BACKUP_OFFSITE=/d' "$ENV_FILE"
  [[ ! -s $ENV_FILE || -z $(tail -c 1 "$ENV_FILE") ]] || printf '\n' >>"$ENV_FILE"
  printf 'SIPGES_BACKUP_OFFSITE=%s\n' "$remote" >>"$ENV_FILE"
  start_offsite
  say "Every backup will also be pushed to $remote, the newest within minutes, then hourly."
  say 'They leave this computer already encrypted: keep the recovery kit, or the remote copies cannot be opened.'
}

# What status says about the off-site copy: where, the newest that arrived, and any failure.
offsite_status() {
  local dir=$1 remote when newest reason
  remote=$(env_value SIPGES_BACKUP_OFFSITE)
  [[ -n $remote ]] || return 0
  if [[ -f $dir/.last-offsite-failure ]]; then
    read -r when reason <"$dir/.last-offsite-failure"
    say "WARNING: the off-site push failed at $when: $reason. See ./sipges logs offsite"
  fi
  if [[ -f $dir/.last-offsite ]]; then
    read -r when newest <"$dir/.last-offsite"
    say "Backups pushed off-site to $remote (newest ${newest:-none yet})"
  fi
  # The service records every hourly round that works, so 26 hours of silence is a stopped push.
  if [[ ! -f $dir/.last-offsite || -z $(find "$dir/.last-offsite" -mmin -1560 2>/dev/null) ]]; then
    say "WARNING: no backup reached $remote in the last 26 hours. See ./sipges logs offsite"
  fi
}

cmd_backups() {
  need_env
  if [[ ${1:-} == --offsite ]]; then
    [[ -n $(env_value SIPGES_BACKUP_OFFSITE) ]] || die 'no off-site copy is set: see ./sipges offsite-to'
    ensure_rclone_conf
    compose run --rm --no-deps offsite list
    return
  fi
  find "$(env_value SIPGES_BACKUP_DIR)" -mindepth 1 -maxdepth 1 -type d -name '20*Z' -printf '%f\n' | sort
}

cmd_restore() {
  need_env
  local name=${1:-} confirm=${2:-}
  [[ -n $name ]] || die 'usage: ./sipges restore <backup name> (see ./sipges backups)'
  [[ $name =~ ^20[0-9]{6}T[0-9]{6}Z$ ]] || die "\"$name\" is not a backup name"
  if [[ ! -d "$(env_value SIPGES_BACKUP_DIR)/$name" ]]; then
    local remote
    remote=$(env_value SIPGES_BACKUP_OFFSITE)
    [[ -n $remote ]] || die "no backup named $name"
    # Fetched and checked before anything stops (world-class-local T13).
    say "Fetching $name from $remote..."
    ensure_rclone_conf
    compose run --rm --no-deps offsite fetch "$name" ||
      die "no backup named $name here, and it could not be fetched from $remote. See ./sipges backups --offsite"
  fi
  if [[ $confirm != --yes ]]; then
    say "This replaces everything in SIPGES with backup $name. Type RESTORE to go on:"
    read -r answer
    [[ $answer == RESTORE ]] || die 'nothing was changed'
  fi
  local services
  services=$(api_services) || exit 1
  # shellcheck disable=SC2086 # one word per service
  compose stop $services caddy backup
  wait_db
  # Written first and removed only on a known outcome: a power cut leaves it, and SIPGES stays off.
  # A run that fails while an earlier one is unfinished clears nothing, whatever it reports.
  local status=0 earlier=0
  [[ ! -f $(unfinished_restore) ]] || earlier=1
  printf '%s' "$name" >"$(unfinished_restore)"
  compose run --rm restore "$name" || status=$?
  if ((status == 0)); then
    command rm -f "$(unfinished_restore)"
    start
    say "Restored $name."
  elif ((status == 1 && earlier == 0)); then
    command rm -f "$(unfinished_restore)"
    start
    die 'the restore failed before changing anything; SIPGES is back on the data it had'
  else
    die 'the restore stopped halfway, so SIPGES stays off. Run the restore again; the lines above name the backup if it is another one'
  fi
}

# A backup and a build both need room: a full disk halfway through either leaves a partial behind
# and the old version running, so both stop first and say why (world-class-local T6).
MIN_FREE_KB=$((5 * 1024 * 1024))
need_free_disk() {
  local dir free
  dir=$(env_value SIPGES_BACKUP_DIR)
  dir=${dir:-./backups}
  mkdir -p "$dir"
  free=$(df -Pk "$dir" | awk 'NR == 2 { print $4 }')
  [[ $free =~ ^[0-9]+$ ]] || return 0
  ((free >= MIN_FREE_KB)) ||
    die "only $((free / 1024 / 1024)) GB free on the disk of $dir: 5 GB are needed. Free some space, or move the backups with SIPGES_BACKUP_DIR"
}

cmd_backup() {
  need_env
  need_free_disk
  compose exec -T backup bash /ops/backup.sh
}

# Back to the build before the last update, without touching the data (world-class-local T6): every
# migration keeps the previous version working, which is what lets the APIs roll one at a time.
cmd_rollback() {
  need_env
  need_docker
  docker image inspect sipges-local:previous >/dev/null 2>&1 ||
    die 'no previous version to go back to: this install was never updated'
  docker tag sipges-local:previous sipges-local:current
  start
  say 'Back on the previous version. The data is as it was. ./sipges update returns to the latest.'
}

cmd_update() {
  need_env
  need_docker
  preflight
  need_free_disk
  compose exec -T backup bash /ops/backup.sh
  if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "$REPO_ROOT" pull --ff-only
  fi
  build
  start
  say 'Updated. If something is wrong, see "Going back" in the guide.'
}

cmd_wipe() {
  need_env
  if [[ ${1:-} != --yes ]]; then
    say 'This deletes the database, the evidence files and the certificates. Backups and .env stay.'
    say 'Type WIPE to go on:'
    read -r answer
    [[ $answer == WIPE ]] || die 'nothing was changed'
  fi
  compose --profile ops down --volumes --remove-orphans
  # An empty install has no restore left to finish.
  command rm -f "$(unfinished_restore)"
}

case ${1:-help} in
install) shift; cmd_install "$@" ;;
prepare) shift; cmd_prepare "$@" ;;
import) shift; cmd_import "$@" ;;
inventory) shift; cmd_inventory "$@" ;;
build) need_docker; build ;;
start) need_env; start ;;
stop) need_env; compose stop ;;
status) cmd_status ;;
logs) need_env; shift; compose logs --tail=200 "$@" ;;
backup) cmd_backup ;;
rollback) cmd_rollback ;;
backups) shift; cmd_backups "$@" ;;
copy-backups-to) shift; cmd_copy_backups_to "$@" ;;
offsite-config) cmd_offsite_config ;;
offsite-to) shift; cmd_offsite_to "$@" ;;
restore) shift; cmd_restore "$@" ;;
recovery-kit) shift; cmd_recovery_kit "$@" ;;
update) cmd_update ;;
ca) need_env; compose cp caddy:/data/caddy/pki/authorities/local/root.crt sipges-root-ca.crt; say 'Wrote sipges-root-ca.crt' ;;
wipe) shift; cmd_wipe "$@" ;;
help | -h | --help)
  cat <<HELP
./sipges install [host]    First install, or rebuild and start. Host defaults to localhost.
./sipges prepare [host]    First install for a client with data: no application yet.
./sipges inventory <dir>   List what a client's folder holds. Changes nothing.
./sipges import ...        Read client files. Only tries, unless given --apply.
./sipges start | stop      Start or stop everything.
./sipges status            What is running, the latest backup, any backup failure.
./sipges logs [service]    Recent logs: api, db, caddy, backup, offsite.
./sipges backup            Take a backup now.
./sipges backups [--offsite]  List the backups, here or on the off-site remote.
./sipges copy-backups-to <dir>  Also copy every backup to a folder on another disk.
./sipges offsite-config    Set up an rclone remote (SFTP, S3-compatible...) for off-site copies.
./sipges offsite-to <remote:folder> | --off  Also push every backup to that remote, hourly.
./sipges restore <name>    Replace all data with a backup; fetched from the remote if not here.
./sipges recovery-kit [file]  Write the sheet with the backup secrets to print, and confirm it.
./sipges update            Back up, get the new version, rebuild, restart.
./sipges rollback          Go back to the version before the last update. The data stays.
./sipges ca                Export the certificate each computer must trust.
./sipges wipe              Delete all data on this machine. Backups and .env stay.
HELP
  ;;
*) die "unknown command \"$1\": see ./sipges help" ;;
esac
