# The off-site push (world-class-local T13): the backup service's PostgreSQL image, for its bash and
# GNU tools, plus the static rclone binary. Both pinned by digest; the build reads nothing else.
FROM rclone/rclone:1.75.2@sha256:2687085f718d3c628f7fdfb77c52a1d344332aed543110bb88088f2c70d43eb5 AS rclone

FROM postgres:17@sha256:748a18a54d3842d43bc156f0840d78029b8d349e0feca98c12b9c4ce3404a6b3
COPY --from=rclone /usr/local/bin/rclone /usr/local/bin/rclone
