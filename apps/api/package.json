{
  "name": "@sipges/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bench": "node bench/run.ts",
    "migrate:legacy": "node ../../scripts/rust-tool.mjs sipges-migrate-legacy migrate-legacy migrate:legacy",
    "migrate:legacy:ts": "node src/tools/migrate-legacy/cli.ts",
    "bench:compare": "node bench/compare.ts",
    "bench:prod-screens": "node bench/prod-screens-stress.ts",
    "vapid:keys": "node src/tools/vapid-keys.ts",
    "import:base-maestra": "node ../../scripts/rust-tool.mjs sipges-base-maestra import-base-maestra import:base-maestra",
    "import:base-maestra:ts": "node src/tools/base-maestra/cli.ts",
    "review:materialize": "node ../../scripts/rust-tool.mjs sipges-review-materialize review-materialize review:materialize",
    "review:materialize:ts": "node src/tools/review-materialize/cli.ts",
    "rotate:data-key": "node ../../scripts/rust-tool.mjs sipges-rotate-data-key rotate-data-key rotate:data-key",
    "rotate:data-key:ts": "node src/tools/rotate-data-key/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-tools": "0.4.15",
    "@hono/node-server": "^2.1.6",
    "@sipges/contracts": "workspace:*",
    "@sipges/kernel": "workspace:*",
    "@noble/hashes": "2.4.0",
    "@node-rs/argon2": "^2.2.2",
    "docx": "^9.15.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.16",
    "postgres": "^4.0.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
