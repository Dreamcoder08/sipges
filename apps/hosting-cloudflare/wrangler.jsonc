{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sipges",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  // Implied by this date (2026-08-04+); explicit so node:async_hooks still works if the date is lowered.
  "compatibility_flags": ["nodejs_compat"],
  // workerd cannot load the native Argon2 addon; the adapter injects the plain-JavaScript hasher.
  "alias": { "@node-rs/argon2": "./src/native-argon2-unavailable.ts" },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": false }],
  // Every request reaches the Worker first, so SIPGES applies its own CSP, security headers
  // and host allowlist to the SPA too; the binding only reads the built files. Built files and
  // the HTML shell skip the backend (no database), see src/index.ts and the deployment guide.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "9eae2c5e3d614feca42b525fc82e10e1" }],
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "sipges-evidence" }],
  "triggers": { "crons": ["*/15 * * * *"] },
  // Not secret: the public host. Secrets go through `wrangler secret put` (deployment guide).
  "vars": { "SIPGES_ALLOWED_HOSTS": "sipges.dreamcoder-dev08.workers.dev" },
  // The Go container (docs/adr/0032 §4), the same as wrangler.go.jsonc. Nothing reaches it: routing
  // needs SIPGES_GO_ROUTING, which only the change adding the first routes sets, and GO_ROUTES is
  // empty. The first deploy of this class cannot be rolled back with `wrangler rollback`:
  // docs/deployment/cloudflare-workers.md.
  "containers": [
    {
      "class_name": "GoBackend",
      "image": "../api-go/Dockerfile",
      "image_build_context": "../..",
      // One named instance serves (src/go-routes.ts GO_INSTANCE); the second covers a rollout.
      "max_instances": 2,
      // `lite` (256 MiB, 1/16 vCPU) was OOM-killed at 4 clients and takes 8 s to compile the engines.
      "instance_type": "basic",
      // Next to Neon aws-us-east-1; ENAM placed the spike in Toronto, Miami or Atlanta.
      "constraints": { "regions": ["ENAM"] },
    },
  ],
  // `wrangler dev` needs no Docker: no local route reaches the container.
  "dev": { "enable_containers": false },
  "durable_objects": { "bindings": [{ "name": "GO_BACKEND", "class_name": "GoBackend" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GoBackend"] }],
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": true },
}
