{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mascli",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  // Implied by this date (2026-08-04+); explicit so node:async_hooks still works if the date is lowered.
  "compatibility_flags": ["nodejs_compat"],
  // workerd cannot load the native Argon2 addon; the adapter injects the plain-JavaScript hasher.
  "alias": { "@node-rs/argon2": "./src/native-argon2-unavailable.ts" },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": false }],
  // Every request reaches the Worker first, so MASCLI applies its own CSP, security headers
  // and host allowlist to the SPA too; the binding only reads the built files.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "9eae2c5e3d614feca42b525fc82e10e1" }],
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "mascli-evidence" }],
  "triggers": { "crons": ["*/15 * * * *"] },
  // Not secret: the public host. Secrets go through `wrangler secret put` (deployment guide).
  "vars": { "MASCLI_ALLOWED_HOSTS": "mascli.dreamcoder-dev08.workers.dev" },
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": true },
}
