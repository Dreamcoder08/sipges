{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sipges",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  // Implied by this date (2026-08-04+); explicit so node:async_hooks still works if the date is lowered.
  "compatibility_flags": ["nodejs_compat"],
  // workerd cannot load the native Argon2 addon; the adapter injects the plain-JavaScript hasher.
  "alias": { "@node-rs/argon2": "./src/native-argon2-unavailable.ts" },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": false }],
  // Every request reaches the Worker first, so SIPGES applies its own CSP, security headers
  // and host allowlist to the SPA too; the binding only reads the built files. Built files and
  // the HTML shell skip the backend (no database), see src/index.ts and the deployment guide.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  // Local placeholder: deploy-config.mjs writes wrangler.deploy.jsonc with the id of the owner's
  // Hyperdrive (GitHub variable SIPGES_HYPERDRIVE_ID). `wrangler dev` reads the database from
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE instead.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "sipges-evidence" }],
  "triggers": { "crons": ["*/15 * * * *"] },
  // Not private: the public host. `localhost` serves `wrangler dev`; the deploy writes the owner's
  // (GitHub variable SIPGES_PUBLIC_HOST). Private values go through `wrangler secret put` (deployment guide).
  "vars": { "SIPGES_ALLOWED_HOSTS": "localhost" },
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": true },
}
