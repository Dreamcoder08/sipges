{
  "name": "@sipges/hosting-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "migrations": "node generate-migrations.mjs",
    "bundle": "wrangler deploy --dry-run --outdir dist",
    "migrate": "node migrate.mjs",
    "dev": "wrangler dev",
    "config:go": "node go-trial-config.mjs",
    "deploy:worker": "wrangler hyperdrive update 9eae2c5e3d614feca42b525fc82e10e1 --caching-disabled true && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@sipges/api": "workspace:*",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "4.156.0"
  }
}
