{
  "name": "@sipges/hosting-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "migrations": "node generate-migrations.mjs",
    "bundle": "wrangler deploy --dry-run --outdir dist",
    "migrate": "node migrate.mjs",
    "dev": "wrangler dev",
    "config:go": "node go-trial-config.mjs",
    "deploy:worker": "node deploy-config.mjs && wrangler hyperdrive update \"$SIPGES_HYPERDRIVE_ID\" --caching-disabled true && wrangler deploy -c wrangler.deploy.jsonc",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@sipges/api": "workspace:*",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "4.157.0"
  }
}
