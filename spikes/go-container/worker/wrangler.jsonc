// Throwaway spike Worker for ADR 0032 (gate S0). Not the production Worker.
// Deploy, measure, then delete: `wrangler delete --name sipges-go-spike`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sipges-go-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "SpikeContainer",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "max_instances": 2,
      "instance_type": "lite",
      "constraints": { "regions": ["ENAM"], "jurisdiction": "us" }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SPIKE", "class_name": "SpikeContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SpikeContainer"] }]
  // Secrets (set with `wrangler secret put`, never committed):
  //   DATABASE_URL, DATABASE_URL_POOLED (optional), SPIKE_TOKEN
}
